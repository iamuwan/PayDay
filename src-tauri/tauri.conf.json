{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PayDay",
  "version": "1.0.0",
  "identifier": "app.payday.tracker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PayDay",
        "width": 1360,
        "height": 900,
        "minWidth": 420,
        "minHeight": 620,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Track pay, bills and spending month by month",
    "copyright": "\u00a9 2026 Uwan Perera. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Uwan Perera"
  }
}
